rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, update, create: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) && isValidId(accountId);
      }

      match /creditCards/{cardId} {
        allow read, write: if isOwner(userId) && isValidId(cardId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) && isValidId(categoryId);
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(userId) && isValidId(txId);
      }
    }
  }
}
